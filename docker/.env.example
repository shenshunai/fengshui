# 平台一键部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- Nacos ----------
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=xuanxue
MYSQL_USER=xuanxue
MYSQL_PASSWORD=xuanxue123

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# ---------- AI 服务（DeepSeek/OpenAI）---------
# 在 ai-service 容器内通过 .env 或下方传入
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# ---------- JWT（玄学服务）---------
JWT_SECRET=XuanXueAppSecretKeyForJWTTokenGeneration2024VeryLongAndSecure
